{
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2020",
		"lib": ["ES2020"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
